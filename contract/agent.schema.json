{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haloagent.local/contract/agent.schema.json",
  "title": "HaloAgent 通信契约",
  "description": "宿主 ↔ 引擎的 NDJSON 帧契约。所有字段 camelCase。信封字段用短名。",
  "contractVersion": 1,
  "frozen": "2025-01-01",
  "envelope": {
    "request": {
      "type": "object",
      "required": [
        "t",
        "id",
        "m"
      ],
      "properties": {
        "t": {
          "const": "req"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "m": {
          "type": "string"
        },
        "p": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "t",
        "id",
        "ok"
      ],
      "properties": {
        "t": {
          "const": "res"
        },
        "id": {
          "type": "integer"
        },
        "ok": {
          "type": "boolean"
        },
        "r": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "e": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "code",
            "msg"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "msg": {
              "type": "string"
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "t",
        "seq",
        "k"
      ],
      "properties": {
        "t": {
          "const": "evt"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "k": {
          "type": "string"
        },
        "p": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "types": {
    "PermissionMode": {
      "type": "string",
      "enum": [
        "ask",
        "acceptEdits",
        "bypassPermissions",
        "yolo"
      ]
    },
    "AskKind": {
      "type": "string",
      "enum": [
        "command",
        "write",
        "rounds"
      ]
    },
    "MessageRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "tool",
        "system"
      ]
    },
    "ToolCallView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "string"
        },
        "ok": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "MessageView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "$ref": "#/types/MessageRole"
        },
        "text": {
          "type": "string"
        },
        "reasoning": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolCalls": {
          "type": "array",
          "items": {
            "$ref": "#/types/ToolCallView"
          }
        },
        "injected": {
          "type": "boolean"
        },
        "tsMs": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "role"
      ]
    },
    "SessionSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "headless": {
          "type": "boolean"
        },
        "mtimeMs": {
          "type": "integer"
        },
        "userMsgs": {
          "type": "integer"
        },
        "assistantMsgs": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title",
        "mtimeMs"
      ]
    },
    "SkillSummary": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "builtin",
            "user",
            "project"
          ]
        },
        "disableModelInvocation": {
          "type": "boolean"
        },
        "hasEntry": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "source"
      ]
    },
    "MemorySummary": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "mtype": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "global",
            "project"
          ]
        },
        "updatedMs": {
          "type": "integer"
        }
      },
      "required": [
        "filename",
        "name",
        "scope"
      ]
    },
    "ToolInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "builtin",
            "mcp",
            "skill"
          ]
        }
      },
      "required": [
        "name",
        "description"
      ]
    },
    "SnapshotInfo": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer"
        },
        "session": {
          "type": "string"
        },
        "orig": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "tsMs": {
          "type": "integer"
        },
        "external": {
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "session",
        "orig",
        "action",
        "tsMs"
      ]
    },
    "Note": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "info",
            "warn",
            "error"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "text"
      ]
    },
    "PendingAsk": {
      "type": "object",
      "properties": {
        "askId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/types/AskKind"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowAlways": {
          "type": "boolean"
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "askId",
        "kind",
        "title",
        "body"
      ]
    },
    "HeaderPair": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "StateSnapshot": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer"
        },
        "engine": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            },
            "pid": {
              "type": "integer"
            },
            "startedAtMs": {
              "type": "integer"
            },
            "osVersion": {
              "type": "string"
            },
            "isWin7": {
              "type": "boolean"
            }
          }
        },
        "session": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "historyPath": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "agent": {
          "type": "object",
          "properties": {
            "busy": {
              "type": "boolean"
            },
            "turnId": {
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "$ref": "#/types/PermissionMode"
            },
            "modeLabel": {
              "type": "string"
            },
            "persona": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "baseUrl": {
              "type": "string"
            },
            "apiKeySet": {
              "type": "boolean"
            },
            "contextWindow": {
              "type": [
                "integer",
                "null"
              ]
            },
            "maxTurns": {
              "type": "integer"
            },
            "retry": {
              "type": "integer"
            },
            "configured": {
              "type": "boolean"
            },
            "round": {
              "type": "object",
              "properties": {
                "used": {
                  "type": "integer"
                },
                "limit": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTotal": {
              "type": "integer"
            },
            "outputTotal": {
              "type": "integer"
            },
            "lastPromptTokens": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "queue": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pendingAsk": {
          "oneOf": [
            {
              "$ref": "#/types/PendingAsk"
            },
            {
              "type": "null"
            }
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/types/MessageView"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/types/Note"
          }
        },
        "update": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "latestVersion": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "required": [
        "protocol",
        "engine",
        "session",
        "agent",
        "usage",
        "queue",
        "messages"
      ]
    }
