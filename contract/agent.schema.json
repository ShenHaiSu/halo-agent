    "agent.unqueue": {
      "params": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "result": {
        "type": "object",
        "properties": {
          "removed": {
            "type": "boolean"
          }
        }
      },
      "implementedIn": "engine"
    },
    "agent.cancel": {
      "params": {
        "type": "object",
        "properties": {
          "turnId": {
            "type": [
              "string",
