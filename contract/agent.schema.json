          "ok": {
            "type": "boolean"
          }
        }
      },
      "implementedIn": "engine"
    },
    "system.diagnostics": {
      "params": null,
      "result": {
        "type": "object",
        "properties": {}
      },
      "implementedIn": "engine"
    },
    "agent.prompt": {
      "params": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "result": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "accepted",
          "turnId"
        ]
      },
      "errors": [
        "state.busy",
        "state.notConfigured"
      ],
      "implementedIn": "engine"
    },
    "agent.queue": {
      "params": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "result": {
        "type": "object",
        "properties": {
          "queued": {
            "type": "boolean"
          },
          "position": {
            "type": "integer"
          }
        }
      },
