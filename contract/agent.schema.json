          "pong": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "protocol": {
            "type": "integer"
          },
          "pid": {
            "type": "integer"
          },
          "uptimeMs": {
            "type": "integer"
          },
          "serverTimeMs": {
            "type": "integer"
          }
        },
        "required": [
          "pong",
          "version",
          "protocol",
          "pid"
        ]
      },
      "implementedIn": "engine"
    },
    "system.info": {
      "params": null,
      "result": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "protocol": {
            "type": "integer"
          },
          "pid": {
            "type": "integer"
          },
          "osVersion": {
            "type": "string"
          },
          "isWin7": {
            "type": "boolean"
          },
          "is64BitOs": {
            "type": "boolean"
          },
          "is64BitProcess": {
            "type": "boolean"
          },
          "runtime": {
            "type": "string"
          },
          "dataDir": {
            "type": "string"
          },
          "startedAtMs": {
            "type": "integer"
          }
        }
      },
      "implementedIn": "engine"
    },
    "system.protocol": {
      "params": null,
      "result": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer"
          },
          "encoding": {
            "type": "string"
          },
          "maxFrameBytes": {
            "type": "integer"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
