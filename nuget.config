<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 清空继承来的源，避免机器级配置偷偷引入其它源 -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- 内网环境在此追加私有源；离线环境替换为本地目录：
         <add key="local" value="D:\nuget-offline" /> -->
  </packageSources>

  <config>
    <!-- 只用已安装的 SDK 版本，不自动下载新的（配合 global.json） -->
    <add key="dependencyVersion" value="HighestMinor" />
  </config>
</configuration>
