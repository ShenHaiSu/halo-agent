<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="HaloAgent.Desktop" />

  <!-- Win7 上如果没有这一节，进程会被判为 legacy，UAC 虚拟化会打开，
       写文件可能被重定向到 VirtualStore，导致"写成功了但找不到"。 -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker：不需要管理员权限。数据写在 %USERPROFILE% 下。 -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- 声明兼容的系统（Win7 到 Win11）。缺了这段，GetVersionEx 会谎报 6.2。 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- DPI 感知：由 Program.cs 的 SetHighDpiMode 在运行时接管，配合
       csproj 的 ApplicationHighDpiMode 属性。
       注意：不要在这里再声明 dpiAware/dpiAwareness，WinForms 分析器
       （WFAC010）会将其视为重复配置并报错。 -->
</assembly>
