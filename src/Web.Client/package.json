{
  "name": "haloagent-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:compat": "node scripts/check-css-compat.mjs",
    "check:icons": "node scripts/check-no-emoji-icons.mjs",
    "check:colors": "node scripts/check-no-hardcoded-colors.mjs",
    "check:tokens": "node scripts/check-token-parity.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "check:all": "pnpm check:pins && pnpm check:compat && pnpm check:icons && pnpm check:colors && pnpm check:tokens && pnpm check:layering",
    "gen:contract": "node scripts/gen-contract-types.mjs",
    "gallery": "vite --open /#/__gallery"
  },
  "dependencies": {
    "@vueuse/core": "~11.3.0",
    "pinia": "~2.2.6",
    "vue": "3.5.13",
    "vue-router": "~4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "~9.15.0",
    "@vitejs/plugin-vue": "~5.2.1",
    "@vue/test-utils": "~2.4.6",
    "autoprefixer": "~10.4.20",
    "eslint": "~9.15.0",
    "eslint-plugin-vue": "~9.31.0",
    "jsdom": "~25.0.1",
    "postcss": "~8.4.49",
    "postcss-import": "15.1.0",
    "postcss-nesting": "~12.1.5",
    "prettier": "~3.4.1",
    "tailwindcss": "3.4.16",
    "typescript": "~5.6.3",
    "typescript-eslint": "~8.16.0",
    "vite": "~5.4.11",
    "vitest": "~2.1.8",
    "vue-tsc": "~2.1.10"
  },
  "packageManager": "pnpm@12.10.1"
}
