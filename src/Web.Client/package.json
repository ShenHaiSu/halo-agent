{
  "name": "halo-agent-web-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "selfcheck": "node --experimental-strip-types scripts/toc.selfcheck.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prebuild": "node scripts/clean-assets.mjs",
    "build": "npm run typecheck && npm run selfcheck && vite build",
    "preview": "vite preview",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "echarts": "5.5.1",
    "highlight.js": "^11.10.0",
    "lucide-vue-next": "^0.454.0",
    "markdown-it": "^14.1.0",
    "naive-ui": "2.45.3",
    "pinia": "2.3.1",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "5.4.21",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
